<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="9dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_tasks_area" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="5dp" android:paddingEnd="5dp" android:contentDescription="自分のやることを開く">
        <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="自分のやること" android:textColor="#14813B" android:textStyle="bold" android:textSize="15sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:textColor="#67756B" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_task_1" style="@style/WidgetTask" />
        <TextView android:id="@+id/widget_task_2" style="@style/WidgetTask" />
        <TextView android:id="@+id/widget_task_3" style="@style/WidgetTask" />
        <TextView android:id="@+id/widget_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#14813B" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/widget_attendance" android:layout_width="54dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:gravity="center" android:background="@drawable/widget_attendance_background" android:text="出欠\n›" android:textColor="#14813B" android:textStyle="bold" android:textSize="14sp" android:contentDescription="出欠を開く" />
</LinearLayout>
