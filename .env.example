# Template only: this file is NOT automatically loaded by the server.
# Inject environment variables through your process manager or hosting secret settings.
HOST=127.0.0.1
PORT=8765
COOKIE_SECURE=0
# Set an HTTPS origin (no path/query/fragment) for production.
# PUBLIC_ORIGIN=https://your-club.example
# CLUB_DB=/persistent-volume/club.sqlite3

# LINE login: disabled until the channel and public HTTPS host are configured.
LINE_LOGIN_ENABLED=0
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI=
# Production example: LINE_REDIRECT_URI=https://your-club.example/api/auth/line/callback
# Enabling LINE also requires PUBLIC_ORIGIN=https://... and COOKIE_SECURE=1.
# Validate the host environment with: python -m server.check_config
# If enabled with invalid settings, server startup fails without printing secrets.
# Never place the channel secret in web/, generated HTML, screenshots, or Git.

# Keep email login during migration. Disable only after owners have linked LINE.
PASSWORD_LOGIN_ENABLED=1

# Optional Web Push, independent of LINE Login (not LINE messaging).
# VAPID_PRIVATE_KEY=/private/path/vapid-private.pem
# VAPID_PUBLIC_KEY=base64url-public-key
# VAPID_CONTACT=mailto:your-real-contact@example.org
